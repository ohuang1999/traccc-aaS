build/
install/
data/
plots/
performance/

# data formats
*.json
*.csv
*.txt
*.cvf
*.sh

# plots
*.png
*.pdf

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# detray_shm/: these are source, not build output. The blanket *.sh and *.txt
# rules above would otherwise drop the scripts and the producer's CMakeLists.
!detray_shm/*.sh
!detray_shm/CMakeLists.txt
