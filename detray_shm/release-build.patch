-# Work around an upstream ACTS packaging bug. 
+# Work around an upstream ACTS packaging bug: the exported targets advertise an
+# eigen3 directory inside the ACTS include tree that is not actually installed.
+# In the image that directory happens to exist; in the ATLAS release it does not,
+# so CMake refuses at generate time. Point every offending entry at the real
+# Eigen instead of assuming a fixed location.
+find_path(REAL_EIGEN3_INCLUDE_DIR signature_of_eigen3_matrix_library
+          PATH_SUFFIXES eigen3)
+if(NOT REAL_EIGEN3_INCLUDE_DIR)
+  message(FATAL_ERROR "Eigen3 not found; cannot repair the ACTS include paths")
+endif()
+
 if(TARGET Eigen3::Eigen)
   set_target_properties(Eigen3::Eigen PROPERTIES
-    INTERFACE_INCLUDE_DIRECTORIES "${traccc_INCLUDE_DIR}/eigen3")
+    INTERFACE_INCLUDE_DIRECTORIES "${REAL_EIGEN3_INCLUDE_DIR}")
 endif()
 
+foreach(_tgt traccc::core traccc::io traccc::device_common traccc::cuda
+             traccc::cuda_utils detray::core detray::io)
+  if(TARGET ${_tgt})
+    get_target_property(_inc ${_tgt} INTERFACE_INCLUDE_DIRECTORIES)
+    if(_inc)
+      set(_fixed "")
+      foreach(_dir ${_inc})
+        if(_dir MATCHES "eigen3$" AND NOT EXISTS "${_dir}")
+          list(APPEND _fixed "${REAL_EIGEN3_INCLUDE_DIR}")
+        else()
+          list(APPEND _fixed "${_dir}")
+        endif()
+      endforeach()
+      set_target_properties(${_tgt} PROPERTIES
+        INTERFACE_INCLUDE_DIRECTORIES "${_fixed}")
+    endif()
+  endif()
+endforeach()
